{
    "compilerOptions": {
        "outDir": "./build/",
        // запрещает использование без типизации
        "noImplicitAny": true,
        "module": "esnext",
        "moduleResolution": "node",
        "target": "esnext",
        "jsx": "react-jsx",
        "allowJs": true,
        // вместо require можно делать обычный импорт
        "esModuleInterop": true,
        // позволяет избавится от * as
        "allowSyntheticDefaultImports": true,
        "baseUrl": ".",
        "paths": {
            "*": [
                "./src/*"
            ]
        },
        // "strict": true
    },
    "include": [
        "src/**/*",
        "./config/jest/setupTest.ts"
    ],
    "exclude": [
        "node_modules",
    ],
    "ts-node": {
        "compilerOptions": {
            "module": "commonjs"
        }
    },
}